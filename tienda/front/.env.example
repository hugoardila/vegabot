# Copia este archivo a .env y completa los valores

# ── API Backend ──────────────────────────────────────────────────────
# URL del backend API (por defecto: http://localhost:8080/api)
VITE_API_URL=http://localhost:8080/api

# ── Google OAuth ─────────────────────────────────────────────────────
# Obtén el Client ID en: https://console.cloud.google.com → APIs y servicios → Credenciales
VITE_GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com

# ── WhatsApp Support ─────────────────────────────────────────────────
# Número de WhatsApp para soporte técnico (formato: código país + número sin +)
VITE_WHATSAPP_SUPPORT=573214815817

# ── Wompi Payment Gateway ────────────────────────────────────────────
# Llave pública de Wompi (obtén la tuya en: https://comercios.wompi.co/my-account/api-keys)
# Usa pub_test_* para pruebas y pub_prod_* para producción
VITE_WOMPI_PUBLIC_KEY=pub_test_yOURpUBLICkEY

