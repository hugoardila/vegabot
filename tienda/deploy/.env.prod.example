# ╔══════════════════════════════════════════════════════════════════════╗
# ║  PRODUCCIÓN - Ubuntu Server                                         ║
# ║  Copia este archivo a .env y completa los valores reales            ║
# ║  NUNCA subas el .env real al repositorio                            ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Docker Hub ───────────────────────────────────────────────────────────
# Tu usuario de Docker Hub (ej: juanperez)
DOCKERHUB_USER=tu-usuario-dockerhub

# ── Base de datos PostgreSQL ─────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=cambia_esto_por_password_muy_segura
DB_NAME=punto_de_venta

# ── JWT Secret ───────────────────────────────────────────────────────────
# Genera uno con: openssl rand -base64 64
JWT_SECRET=cambia_esto_por_secreto_muy_largo_y_aleatorio

# ── Puerto del servidor (interno, no se expone al exterior) ──────────────
PORT=8080

# ── Super Admin ──────────────────────────────────────────────────────────
SUPERADMIN_CEDULA=1083888210
SUPERADMIN_PASSWORD=cambia_esto_por_password_admin_seguro

# ── URL del frontend (tu dominio real de Cloudflare) ─────────────────────
FRONTEND_URL=https://tu-dominio.com

# ── SMTP (correo para recuperación de contraseña) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_de_16_chars
SMTP_FROM=Vega <tu_correo@gmail.com>

# ── Google OAuth ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com

# ── Cloudflare Tunnel ───────────────────────────────────────────────────
# Obtén este token desde: https://one.dash.cloudflare.com → Tunnels → Create
CLOUDFLARE_TUNNEL_TOKEN=pega_aqui_tu_token_largo_de_cloudflare
