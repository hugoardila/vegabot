# Copia este archivo a .env y completa los valores con tus datos reales

# ── Base de datos PostgreSQL ─────────────────────────────────────────
DB_HOST=               # Aquí va tu host de PostgreSQL
DB_PORT=                    # Aquí va tu puerto de PostgreSQL
DB_USER=                 # Aquí va tu usuario de PostgreSQL
DB_PASSWORD=    # Aquí va tu contraseña de PostgreSQL
DB_NAME=          # Aquí va el nombre de tu base de datos

# ── Redis (Cola de Tareas) ───────────────────────────────────────────
REDIS_HOST=             # Aquí va tu host de Redis
REDIS_PORT=                  # Aquí va tu puerto de Redis
REDIS_PASSWORD=  # Aquí va tu contraseña de Redis
REDIS_DB=                      # Aquí va el número de DB de Redis

# ── JWT Secret ───────────────────────────────────────────────────────
# Usa una cadena larga y aleatoria (ejemplo: openssl rand -hex 32)
JWT_SECRET=

# ── Puerto del servidor HTTP ─────────────────────────────────────────
PORT=                     # Aquí va el puerto del servidor API

# ── Usuario Super Admin Base ─────────────────────────────────────────
SUPERADMIN_EMAIL=superadmin@tudominio.com  # Aquí va el email del super admin
SUPERADMIN_PASSWORD=TU_CONTRASEÑA_ADMIN  # Aquí va la contraseña del super admin

# ── URL del frontend ─────────────────────────────────────────────────
# Usada en enlaces de correo (ej: http://localhost:5173 para desarrollo)
FRONTEND_URL=http://localhost:5173

# ── SMTP (para recuperación de contraseña) ──────────────────────────
# Ejemplo con Gmail: habilitar "Contraseñas de aplicación" en tu cuenta
SMTP_HOST=smtp.gmail.com         # Aquí va tu host SMTP
SMTP_PORT=587                     # Aquí va tu puerto SMTP
SMTP_USER=TU_CORREO@ejemplo.com  # Aquí va tu correo SMTP
SMTP_PASSWORD=TU_CONTRASEÑA_SMTP # Aquí va tu contraseña de aplicación SMTP
# SMTP_FROM se usa como remitente; si está vacío usa SMTP_USER
SMTP_FROM=TechPOS <TU_CORREO@ejemplo.com>

# ── Google OAuth ─────────────────────────────────────────────────────
# Obtén el Client ID en: https://console.cloud.google.com
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com

# ── Wompi Payment Gateway ────────────────────────────────────────────
# Obtén tus llaves en: https://comercios.wompi.co/my-account/api-keys
# Usa pub_test_* y prv_test_* para pruebas
# Usa pub_prod_* y prv_prod_* para producción
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# Secreto de integridad para firmas del checkout
WOMPI_INTEGRITY_SECRET=
# Secreto de eventos para webhooks
WOMPI_EVENTS_SECRET=
